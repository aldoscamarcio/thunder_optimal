    <model name="WallObstacle">
      <pose>0.35 0 0.60 0 0 0</pose>
      <link name="wall_link">
        <gravity>false</gravity>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 0.02 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 0.02 0.2</size>
            </box>
          </geometry>
        </collision>
        <inertial>
          <mass>5.71</mass>
          <inertia>
            <ixx>0.07638</ixx>
            <iyy>0.09523</iyy>
            <izz>0.01923</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
    </model>

